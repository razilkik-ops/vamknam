<header id="header" class="header">
  <div class="header-inner">
    <a class="brand" href="./" aria-label="vamknam.by — главная">
      <img src="assets/header/brand-flower.webp" width="56" height="56" alt="">
      <span>vamknam.by</span>
    </a>
    <nav id="main-nav" aria-label="Главная навигация">
      <% for (const item of navigation) { const active = currentPath === item.path || (item.path === '/catalog' && currentPath.startsWith('/product')); %>
        <a href="<%= item.href %>"<% if (active) { %> aria-current="page"<% } %>><%= item.label %></a>
      <% } %>
    </nav>
    <div class="header-contacts" aria-label="Связаться с мастерской">
      <a class="phone" href="tel:+375447535310" aria-label="Позвонить: +375 44 753-53-10">
        <img class="icon" src="assets/header/phone.webp" alt="" width="44" height="44"><span>+375 44 753-53-10</span>
      </a>
      <a class="telegram" href="tg://resolve?phone=375447535310" aria-label="Написать в Telegram">
        <img class="icon" src="assets/header/telegram.webp" alt="" width="44" height="44">
      </a>
    </div>
    <div class="header-actions">
      <a class="header-cart" id="header-cart" href="cart/" aria-label="Открыть корзину" aria-haspopup="dialog" aria-controls="cart-drawer"<% if (currentPath === '/cart') { %> aria-current="page"<% } %>>
        <img class="icon" src="assets/header/cart.webp" alt="" width="44" height="44">
        <span class="cart-badge" data-cart-count hidden>0</span>
      </a>
      <button class="menu-toggle" id="menu-toggle" type="button" aria-label="Открыть меню" aria-controls="main-nav" aria-expanded="false">
        <img class="icon" src="assets/reference/menu.svg" alt="" width="24" height="24">
      </button>
    </div>
  </div>
</header>
